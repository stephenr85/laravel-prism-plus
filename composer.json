{
    "name": "rushing/laravel-prism-plus",
    "description": "Wrap-and-extend over Prism — delegates the existing modalities to prism-php/prism and adds the ones Prism has no slot for (rerank, and later audio/video) as parallel first-class modalities that reuse Prism's own provider credentials.",
    "keywords": ["laravel", "prism", "llm", "rerank", "modality", "voyage", "cohere"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Stephen Rushing",
            "email": "stephen@rushing.dev"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "prism-php/prism": "*"
    },
    "suggest": {
        "rushing/prism-cassette": "Record/replay rerank calls as fixtures (soft-inject; no hard dependency)"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "Rushing\\PrismPlus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rushing\\PrismPlus\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "laravel": {
            "providers": [
                "Rushing\\PrismPlus\\PrismPlusServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
