{
    "name": "rushing/laravel-prism-plus",
    "description": "Wrap-and-extend over Prism — delegates the existing modalities to prism-php/prism and adds the ones Prism has no slot for (rerank, and later audio/video) as parallel first-class modalities that reuse Prism's own provider credentials.",
    "keywords": [
        "laravel",
        "prism",
        "llm",
        "rerank",
        "modality",
        "voyage",
        "cohere"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Stephen Rushing",
            "email": "stephen@rushing.dev"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "prism-php/prism": "*",
        "rushing/laravel-popcorn": "*",
        "rushing/prism-cassette": "dev-main",
        "spatie/laravel-data": "^4.0|^5.0"
    },
    "repositories": [
        {
            "//": "Git fallbacks for a fresh standalone clone with no sibling checkout (e.g. the package's own CI), since neither is on Packagist.",
            "type": "git",
            "url": "https://github.com/stephenr85/laravel-popcorn.git"
        },
        {
            "type": "git",
            "url": "https://github.com/stephenr85/prism-cassette.git"
        }
    ],
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Rushing\\PrismPlus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rushing\\PrismPlus\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "laravel": {
            "providers": [
                "Rushing\\PrismPlus\\PrismPlusServiceProvider"
            ]
        },
        "merge-plugin": {
            "include": [
                "composer.local.json"
            ]
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest",
        "lint": "vendor/bin/pint"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "wikimedia/composer-merge-plugin": true
        }
    }
}
